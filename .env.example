# Every variable is optional. With none set, the free check works on live data
# and the paid features show as unavailable instead of pretending to work.

# Raise kit payments (Stripe test or live secret key)
STRIPE_SECRET_KEY=
KIT_PRICE_CENTS=2500

# Smarter seniority matching and a tailored raise kit
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Watch alerts: storage (Upstash Redis REST / Vercel KV) and email (Resend)
KV_REST_API_URL=
KV_REST_API_TOKEN=
RESEND_API_KEY=
ALERT_FROM_EMAIL=Loyalty Tax <alerts@example.com>

# Protects the daily cron endpoint (Vercel sends it automatically when set)
CRON_SECRET=
